# Python
__pycache__/
*.pyc

data.json
config.json

# PyInstaller build output (see TimeControl.spec)
/build/
/dist/

# Sphinx documentation build output
/docs/_build/
.DS_Store

# The lock guarding data.json against the other writers. Created beside the
# document it protects and never removed, because deleting it would let a
# second process lock a file the first still holds open.
data.json.lock
# The same for the documents the tests write beside it.
*.json.lock
