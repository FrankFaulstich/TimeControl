#: sl/SL_Menu.py:1351 sl/SL_Menu.py:1367
msgid "Project Management"
msgstr "Správa projektů"

#: sl/SL_Menu.py:1494
msgid "No server address is set. Enter one above and save it first."
msgstr "Není nastavena adresa serveru. Zadejte ji výše a uložte."

#: sl/SL_Menu.py:1495
msgid ""
"The address must start with https:// - a token sent over plain HTTP could be "
"read by anyone on the way."
msgstr ""
"Adresa musí začínat https:// – token odeslaný přes nešifrované HTTP by mohl "
"cestou kdokoli přečíst."

#: sl/SL_Menu.py:1497
msgid "Please enter both a username and a password."
msgstr "Zadejte prosím uživatelské jméno i heslo."

#: sl/SL_Menu.py:1498
msgid "Wrong username or password."
msgstr "Nesprávné uživatelské jméno nebo heslo."

#: sl/SL_Menu.py:1499
msgid "Too many sign-in attempts on the server. Try again in a minute."
msgstr "Příliš mnoho pokusů o přihlášení. Zkuste to za minutu znovu."

#: sl/SL_Menu.py:1500
msgid "The server's certificate could not be verified."
msgstr "Certifikát serveru se nepodařilo ověřit."

#: sl/SL_Menu.py:1501
msgid "The server did not answer in time."
msgstr "Server neodpověděl včas."

#: sl/SL_Menu.py:1502
msgid "The server could not be reached. Check the address and your connection."
msgstr "Server není dostupný. Zkontrolujte adresu a připojení."

#: sl/SL_Menu.py:1503
msgid ""
"The address answered, but not like a TimeControl sync server. Check that it "
"points at the right directory."
msgstr ""
"Adresa odpověděla, ale ne jako synchronizační server TimeControl. "
"Zkontrolujte, zda ukazuje na správný adresář."

#: sl/SL_Menu.py:1505
msgid "The server is reachable but has not been set up yet."
msgstr "Server je dostupný, ale ještě není nastaven."

#: sl/SL_Menu.py:1507
msgid "This device is not signed in to the server."
msgstr "Toto zařízení není přihlášeno k serveru."

#: sl/SL_Menu.py:1508 sl/SL_Menu.py:1899
msgid "This device is no longer signed in. Please sign in again."
msgstr "Toto zařízení už není přihlášeno. Přihlaste se prosím znovu."

#: sl/SL_Menu.py:1509
msgid "The synchronisation files on this computer could not be written."
msgstr "Synchronizační soubory na tomto počítači se nepodařilo zapsat."

#: sl/SL_Menu.py:1511
#, python-brace-format
msgid "Sign-in failed ({code})."
msgstr "Přihlášení selhalo ({code})."

