#, python-brace-format
msgid ""
"Skipping user data file: {filename}. It will not be overwritten during "
"restore."
msgstr ""
"Omitiendo archivo de datos de usuario: {filename}. No será sobrescrito "
"durante la restauración."

#: update.py:213
msgid "Previous version restored successfully."
msgstr "Versión anterior restaurada con éxito."

#: update.py:215
msgid "Restarting application to apply changes..."
msgstr "Reiniciando la aplicación para aplicar los cambios..."

#: update.py:218
#, python-brace-format
msgid "Error during restoration: {error}"
msgstr "Error durante la restauración: {error}"

