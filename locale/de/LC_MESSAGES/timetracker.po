msgstr ""
"Sprache geändert. Bitte starten Sie die Anwendung neu, damit die Änderungen "
"wirksam werden."

#: sl/SL_Menu.py:1553
msgid "Restore Previous Version"
msgstr "Vorherige Version wiederherstellen"

#: sl/SL_Menu.py:1556
msgid "The 'update' module is not available. This feature is disabled."
msgstr ""
"Das Modul „Update“ ist nicht verfügbar. Diese Funktion ist deaktiviert."

#: sl/SL_Menu.py:1558
#, python-brace-format
msgid "No previous version backup '{filename}' found."
msgstr "Keine Sicherung der vorherigen Version „{filename}“ gefunden."

#: sl/SL_Menu.py:1560
msgid ""
"This will restore the application to the previously backed-up version. The "
"application will then restart. You may need to manually refresh your browser "
"if it does not reconnect automatically."
msgstr ""
"Dadurch wird die Anwendung auf die zuvor gesicherte Version "
"wiederhergestellt. Die Anwendung wird dann neu gestartet. Möglicherweise "
"müssen Sie Ihren Browser manuell aktualisieren, wenn die Verbindung nicht "
"automatisch wiederhergestellt wird."

#: sl/SL_Menu.py:1561
msgid "Restore and Restart"
msgstr "Wiederherstellen und neu starten"

#: sl/SL_Menu.py:1562
msgid "Restoring and restarting..."
msgstr "Wiederherstellung und Neustart..."

#: sl/SL_Menu.py:1565
msgid "Restore complete. Please restart the application."
msgstr "Wiederherstellung abgeschlossen. Bitte starten Sie die Anwendung neu."

#: sl/SL_Menu.py:1567
